<!DOCTYPE html>
<html>
  <head>
    <title>Admin — <%= content_for(:title) || "AuctionDEMO" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-danger mb-4">
      <div class="container">
        <%= link_to "AuctionDEMO Admin", admin_root_path, class: "navbar-brand fw-bold" %>
        <div class="d-flex gap-2 ms-auto align-items-center">
          <%= link_to "View Site", root_path, class: "btn btn-outline-light btn-sm" %>
          <span class="text-light small"><%= current_admin_user.email %></span>
          <%= button_to "Sign out", destroy_admin_user_session_path, method: :delete, class: "btn btn-outline-light btn-sm" %>
        </div>
      </div>
    </nav>

    <div class="container">
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
